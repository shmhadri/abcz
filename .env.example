DEBUG=False
DJANGO_ENV=production
SECRET_KEY=
DATABASE_URL=
DB_CONN_MAX_AGE=60
REDIS_URL=
CACHE_KEY_PREFIX=abcz
SUBSCRIPTION_CACHE_TIMEOUT=300
STATIC_CONTENT_CACHE_TIMEOUT=1800
PUBLIC_PAGE_CACHE_TIMEOUT=600
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=True
BACK_TO_SCHOOL_ENABLED=True
BACK_TO_SCHOOL_DISCOUNT_PERCENT=25
STATIC_ROOT=
MEDIA_ROOT=
DISABLE_AUTO_SEED=false
# Keep the A1/A2 journey hidden until content review is complete.
ENGLISH_PATH_ENABLED=false
RUN_MIGRATIONS_ON_BUILD=false
RUN_MIGRATIONS_ON_STARTUP=false
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=45
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEP_ALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

MOYASAR_ENABLED=false
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
MOYASAR_CALLBACK_URL=
MOYASAR_WEBHOOK_URL=
